APP_ENV=development
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
MODEL_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
DATABASE_URL=postgresql+psycopg://rag:change-me-for-local-only@postgres:5432/rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-for-local-only
POSTGRES_DB=rag
CELERY_BROKER_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=multimodal_rag_openai_large
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=rag-local-user
S3_SECRET_KEY=change-me-for-local-only
S3_BUCKET=rag-assets
S3_SECURE=false
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_BYTES=20971520
MAX_PDF_PAGES=300
PDF_RENDER_DPI=144
RETRIEVAL_LIMIT=8
